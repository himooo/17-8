// ====================================================================
// Optional AI provider keys — encrypted at rest, never returned to client
// ====================================================================
model AiProviderKey {
  id                  String    @id @default(cuid())
  label               String
  provider            String    @default("google")
  apiKind             String    @default("provider") // provider | openai-compatible
  baseUrl             String?
  modelsUrl           String?
  chatUrl             String?
  encryptedKey        String
  keyHint             String    @default("")
  model               String    @default("gemini-2.5-flash")
  specialty           String    @default("general") // general | math | arabic | science | images | audio
  scopesJson          String    @default("[\"generate\"]")
  capabilitiesJson    String    @default("[\"text\"]")
  isActive            Boolean   @default(true)
  priority            Int       @default(0)
  status              String    @default("active") // active | cooldown | failed | disabled | needs-check
  cooldownUntil       DateTime?
  rpmLimit            Int?
  dailyLimit          Int?
  maxConcurrency      Int       @default(2)
  lastUsedAt          DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastErrorCode       String?
  lastError           String?
  consecutiveFailures Int       @default(0)
  successCount        Int       @default(0)
  failureCount        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([provider, isActive, priority])
  @@index([status, cooldownUntil])
  @@map("ai_provider_keys")
}

