// ====================================================================
// Reports + Telegram V10
// Teacher-owned local configuration and delivery queues. These models do
// not push data to Moodle and never store raw provider secrets.
// ====================================================================

model ReportTemplate {
  id          String   @id @default(cuid())
  name        String
  kind        String   @default("student")
  language    String   @default("ar")
  sectionsJson String  @default("[\"summary\"]")
  scopeClassId String?
  isDefault   Boolean  @default(false)
  enabled     Boolean  @default(true)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, enabled])
  @@index([scopeClassId, kind])
  @@map("report_templates")
}

model ReportSchedule {
  id          String   @id @default(cuid())
  kind        String   @default("weekly")
  enabled     Boolean  @default(false)
  classId     String?
  templateId  String?
  frequency   String   @default("weekly")
  timezone    String   @default("Africa/Cairo")
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  lastStatus  String?
  lastError   String?
  revision    Int      @default(1)
  configJson  String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, nextRunAt])
  @@index([classId, frequency])
  @@map("report_schedules")
}

model TelegramParentPreference {
  id          String   @id @default(cuid())
  studentId   String   @unique
  chatId      String
  language    String   @default("ar")
  sectionsJson String  @default("[\"summary\",\"attendance\",\"homework\",\"achievements\"]")
  frequency   String   @default("weekly")
  liveEvents  Boolean  @default(false)
  reminders   Boolean  @default(false)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([chatId])
  @@index([frequency, liveEvents, reminders])
  @@map("telegram_parent_preferences")
}

model TelegramMessageQueue {
  id             String   @id @default(cuid())
  chatId         String
  studentId      String?
  kind           String   @default("report")
  method         String   @default("sendMessage")
  payloadJson    String   @default("{}")
  idempotencyKey String   @unique
  status         String   @default("pending")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(5)
  nextAttemptAt  DateTime @default(now())
  lastError      String?
  createdAt      DateTime @default(now())
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([chatId, createdAt])
  @@index([studentId, status])
  @@map("telegram_message_queue")
}


model TelegramMessageTemplate {
  id          String   @id @default(cuid())
  type        String   @default("summary")
  language    String   @default("ar")
  name        String
  template    String
  variablesJson String @default("[]")
  enabled     Boolean  @default(true)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, language, enabled])
  @@map("telegram_message_templates")
}
