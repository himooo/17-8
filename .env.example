# Bisalasa — environment variables reference (names only, no real secrets)
# Copy to .env and adjust. Only DATABASE_URL is required for local runs.

# SQLite database (canonical location: <root>/data/custom.db)
DATABASE_URL="file:../data/custom.db"

# Optional encryption secrets — when unset, derived secrets are stored in data/*.secret
# BISALASA_AI_KEY_SECRET=
# BISALASA_AI_KEY_SECRET_FILE=
# BISALASA_MOODLE_KEY_SECRET=
# BISALASA_TELEGRAM_KEY_SECRET=
# BISALASA_DATA_DIR=

# Optional integrations
# LIVE_SYNC_SHARED_SECRET=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# HTTPS=1
